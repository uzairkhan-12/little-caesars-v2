[Unit]
Description=Little Caesars Command Deck
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/little-caesars-v2
EnvironmentFile=-/root/little-caesars-v2/.env
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=HOST=0.0.0.0
ExecStart=/usr/bin/env node .output/server/index.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
